#Get current dir.
get_filename_component(_AUDI_CONFIG_SELF_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

# Find the dependencies. All of them are looked up in CONFIG mode using the
# package configuration files shipped by the respective projects.
include(CMakeFindDependencyMacro)
find_dependency(Threads REQUIRED)
# Modern Boost lookup (CONFIG mode + imported targets). The serialization
# component is the only compiled Boost library required by the audi target.
find_dependency(Boost @_audi_MIN_BOOST_VERSION@ REQUIRED CONFIG COMPONENTS serialization)
find_dependency(obake REQUIRED CONFIG)
find_dependency(Eigen3 REQUIRED CONFIG)
find_dependency(mp++ REQUIRED CONFIG)

include(${_AUDI_CONFIG_SELF_DIR}/audi_export.cmake)

#Clean up.
unset(_AUDI_CONFIG_SELF_DIR)
